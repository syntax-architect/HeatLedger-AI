# ==============================================================================
# HeatLedger AI - Environment Configuration Template
# Three Environments: Local (Docker Compose), Staging, and Production
# ==============================================================================

# --- 1. Environment & Brand ---
# Allowed values: local, development, staging, production
ENV=development
BRAND_NAME=HeatLedger AI
DEMO_MODE=false

# --- 2. Database Connection ---
# Local Docker Compose: postgresql://heatledger:heatledger_secure_2026@localhost:5432/heatledger_db
# Local SQLite Dev: Leave DATABASE_URL empty to use auth_database.sqlite3
# Staging/Production: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# --- 3. Cryptographic Secrets (Must be random, >= 32 characters in production) ---
# Generate using: openssl rand -hex 32
JWT_SECRET=dev_jwt_secret_64_characters_long_for_local_development_testing_only!
URL_SIGNING_SECRET=dev_url_signing_secret_64_characters_for_local_development_testing!
DOCUMENT_URL_SECRET=dev_document_url_secret_64_characters_long_for_local_dev_only!!
ENCRYPTION_KEY=dev_aes_encryption_key_32_bytes_long_exact!

# --- 4. CORS Allowed Origins ---
# Comma-separated URLs. In production: strict HTTPS domains only, no localhost, no '*'
# Dev/Local:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Staging:
# ALLOWED_ORIGINS=https://staging.heatledger.ai
# Production:
# ALLOWED_ORIGINS=https://app.heatledger.ai,https://heatledger.ai

# --- 5. Google Gemini API (Vision OCR Escalation) ---
# Set GEMINI_API_KEY for Tier-2 extraction fallback
GEMINI_API_KEY=
LOCAL_PARSER_ONLY=false

# --- 6. Razorpay Payment Gateway ---
# Local/Staging Test Mode: Key ID starts with rzp_test_
# Production Mode: Key ID MUST start with rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- 7. Resend Transactional Email ---
# Required in production. Key starts with re_
RESEND_API_KEY=
SUPPORT_EMAIL=support@heatledger.ai

# --- 8. Error Monitoring & Telemetry ---
# Sentry DSN (https://...ingest.sentry.io/...)
SENTRY_DSN=
APP_RELEASE=heatledger-ai@2.0.0

# --- 9. Frontend Client Variables (VITE_ prefix only, NO secrets in frontend) ---
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000
VITE_BRAND_NAME=HeatLedger AI
