# ==============================================================================
# HeatLedger AI - Environment Configuration Template
# Copy this file to .env and provide your deployment or local credentials
# ==============================================================================

# --- Core Security Secrets (Required in Production) ---
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_for_production
URL_SIGNING_SECRET=replace_with_a_secure_random_64_character_hex_secret_for_signed_urls

# --- Google Gemini API (Required for Vision OCR Extraction) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase PostgreSQL Configuration (Optional in local SQLite development) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Frontend Connection URL ---
VITE_BACKEND_URL=http://localhost:8000

# --- Environment Mode & Demo Safeguards ---
ENV=development
DEMO_MODE=false
