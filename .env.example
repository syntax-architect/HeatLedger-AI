# ==============================================================================
# HeatLedger AI - Environment Configuration Template (Prompt Pack v5 Task 4.1)
# NEVER commit working secrets. Replace every CHANGE_ME value before starting.
# ==============================================================================

# --- 1. Environment & Brand ---
# Allowed values: test, local, development, staging, production
ENV=development
BRAND_NAME=HeatLedger AI
DEMO_MODE=false

# --- 2. Database Connection ---
# Local Docker Compose: postgresql://heatledger:CHANGE_ME_DB_PASSWORD@localhost:5432/heatledger_db
# Staging/Production: postgresql://app_api:CHANGE_ME_DB_PASSWORD@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# --- 3. Cryptographic Secrets (Single Purpose Keys, >= 32 random chars required) ---
# Generate each key independently using: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
URL_SIGNING_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
DOCUMENT_URL_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ENCRYPTION_KEY_VERSION=v1
# Optional during rotation: comma-separated 'version:old_secret' pairs
ENCRYPTION_PREVIOUS_KEYS=

# --- 4. Webhook & Internal Cron Secrets (>= 32 random chars recommended) ---
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET
INTAKE_EMAIL_WEBHOOK_SECRET=CHANGE_ME_INTAKE_EMAIL_WEBHOOK_SECRET
WHATSAPP_APP_SECRET=CHANGE_ME_WHATSAPP_APP_SECRET
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WHATSAPP_VERIFY_TOKEN
CRON_SECRET=CHANGE_ME_CRON_SECRET

# --- 5. CORS Allowed Origins ---
# Comma-separated URLs. In production: strict HTTPS domains only, no localhost, no '*'
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- 6. Google Gemini API (Vision OCR Escalation) ---
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
LOCAL_PARSER_ONLY=false

# --- 7. Razorpay Payment Gateway ---
# Local/Staging Test Mode: Key ID starts with rzp_test_
# Production Mode: Key ID MUST start with rzp_live_
RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET

# --- 8. Resend Transactional Email ---
# Required in production. Key starts with re_
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
SUPPORT_EMAIL=support@heatledger.ai

# --- 9. Error Monitoring & Telemetry ---
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
APP_RELEASE=heatledger-ai@2.0.0

# --- 10. Frontend Client Variables (VITE_ prefix only, NO secrets in frontend) ---
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000
VITE_BRAND_NAME=HeatLedger AI
